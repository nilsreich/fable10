{
  "name": "litemath",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/react && cd packages/svelte && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "verify": "bun run typecheck && bun run test && bun run size",
    "demo:build": "node scripts/build-demo.mjs",
    "demo": "node scripts/build-demo.mjs && bun demo/serve.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.0",
    "react": "^19",
    "react-dom": "^19",
    "svelte": "^5",
    "svelte-check": "^4.7.2",
    "typescript": "^5.8.0",
    "vite": "^7",
    "vitest": "^3.2.0"
  }
}
